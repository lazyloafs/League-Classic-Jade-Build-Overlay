{
  "name": "jade-overlay",
  "version": "1.3.0",
  "private": true,
  "description": "Jade - League Classic (JADE) item build editor and in-game next-item overlay with gold-needed tracking",
  "keywords": [
    "league-of-legends",
    "league-classic",
    "jade",
    "item-build",
    "build-editor",
    "overlay",
    "electron",
    "live-client-data-api",
    "lol",
    "gold-tracker"
  ],
  "author": "LazyLoafs",
  "homepage": "https://github.com/lazyloafs/League-Classic-Jade-Build-Overlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazyloafs/League-Classic-Jade-Build-Overlay.git"
  },
  "bugs": {
    "url": "https://github.com/lazyloafs/League-Classic-Jade-Build-Overlay/issues"
  },
  "main": "overlay/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js",
    "mock": "node server/index.js --mock",
    "test": "node --test",
    "dist": "electron-builder --win --publish never",
    "pack": "electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lazyloafs.jade-overlay",
    "productName": "Jade Overlay",
    "copyright": "Jade Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server/**",
      "web/**",
      "overlay/**",
      "data/**",
      "builds/**",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Jade Overlay",
      "artifactName": "Jade-Overlay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Jade-Overlay-Portable-${version}.${ext}"
    }
  }
}
